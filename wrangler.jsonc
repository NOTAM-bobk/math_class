{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathclassgames",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathclassgames",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  // Cloudflare Turnstile. Only public values belong in this file: the site key
  // ships to the browser and the allowed hostnames are not sensitive. The secret
  // key stays out of the repository and is set with
  // `wrangler secret put TURNSTILE_SECRET_KEY`.
  "vars": {
    "TURNSTILE_ALLOWED_HOSTNAMES": "games.mathclass.uk",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGD_UD2iO_H1KdGs"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static assets are served before the Worker by default, so index.html
    // would never reach the code in worker.js that leaves only the current
    // domain's BidVertiser verification code on the page. Running the Worker
    // first covers every HTML response, including the SPA fallback for unknown
    // paths; it hands non-HTML assets straight back to the asset store.
    "run_worker_first": true
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathclassgames",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static assets are served before the Worker by default, so index.html
    // would never reach the code in worker.js that leaves only the current
    // domain's BidVertiser verification code on the page. These are the routes
    // that serve that HTML; everything else keeps the asset-first path.
    "run_worker_first": [
      "/",
      "/index.html",
      "/games",
      "/games/*",
      "/game/*",
      "/settings",
      "/settings/",
      "/bug"
    ]
  }
}

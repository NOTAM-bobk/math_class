{
  "name": "polytrack-hub",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:css && node scripts/export-catalog.mjs && node scripts/export-offline-packs.mjs && node scripts/build-client.mjs && node scripts/export-offline-manifest.mjs",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./dist/styles.css --minify",
    "build:catalog": "node scripts/export-catalog.mjs",
    "check:games": "node scripts/check-games.mjs",
    "build:covers": "node scripts/build-game-covers.mjs",
    "build:offline-manifest": "node scripts/export-offline-manifest.mjs",
    "build:packs": "node scripts/export-offline-packs.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@fingerprintjs/botd": "^2.0.0",
    "@shadcn/react": "^0.3.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^0.460.0",
    "posthog-js": "^1.451.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^4.6.13",
    "tailwind-merge": "^2.5.5",
    "video.js": "^8.21.0",
    "videojs-contrib-ads": "^7.5.2",
    "videojs-ima": "^2.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.19"
  }
}

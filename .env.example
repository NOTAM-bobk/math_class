# Public PostHog project settings, required at build time for analytics.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile. The site key is public; the secret stays server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated production/preview hostnames, for example:
# TURNSTILE_ALLOWED_HOSTNAMES=math-class.example.com,math-class-git-main-sawyerbobk563s-projects.vercel.app
TURNSTILE_ALLOWED_HOSTNAMES=

# EmailJS share-by-email. The share dialog posts to /api/share-email, so these stay
# server-side. Create a template whose "To email" field is {{to_email}} and whose body
# uses {{share_url}} (and optionally {{page_title}} / {{site_name}}).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional: required when the EmailJS account has strict mode / a private key enabled.
EMAILJS_PRIVATE_KEY=

# Read-only UptimeRobot API key for the uptime timeline in Settings > Change log.
# Create one under Integrations & API in the UptimeRobot dashboard.
UPTIMEROBOT_API_KEY=

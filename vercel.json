{
  "outputDirectory": ".",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/dist/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/dist/home.bundle.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/games/config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/search",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/games", "destination": "/index.html" },
    { "source": "/games/", "destination": "/index.html" },
    { "source": "/game/:path*", "destination": "/index.html" },
    {
      "source": "/bug",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/checkout/",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/settings/",
      "destination": "/index.html"
    },
    {
      "source": "/api/mp/:path*",
      "destination": "/api/mp/[...path]"
    },
    {
      "source": "/bidvertiser/:path*",
      "destination": "https://cdn.hyperpromote.com/bidvertiser/:path*"
    },
    {
      "source": "/imasdk/:path*",
      "destination": "https://imasdk.googleapis.com/js/sdkloader/:path*"
    },
    {
      "source": "/adserv/:path*",
      "destination": "https://youradexchange.com/:path*"
    },
    {
      "source": "/api/avatar",
      "destination": "/api/avatar"
    },
    {
      "source": "/api/avatar/:path*",
      "destination": "/api/avatar"
    },
    {
      "source": "/api/version",
      "destination": "/version.json"
    },
    {
      "source": "/api/version/",
      "destination": "/version.json"
    },
    {
      "source": "/api/games/flags",
      "destination": "/api/flags"
    },
    {
      "source": "/api/games/flags/",
      "destination": "/api/flags"
    },
    {
      "source": "/api/hub/messages",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/messages"
    },
    {
      "source": "/api/hub/messages/",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/messages"
    },
    {
      "source": "/api/hub/views",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/views"
    },
    {
      "source": "/api/hub/views/",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/views"
    },
    {
      "source": "/api/hub/bugs",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/bugs"
    },
    {
      "source": "/api/hub/bugs/",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/bugs"
    },
    {
      "source": "/api/hub/admin/bugs",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/admin/bugs"
    },
    {
      "source": "/api/hub/admin/bugs/",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/admin/bugs"
    },
    {
      "source": "/api/hub/games/flags",
      "destination": "/api/flags"
    },
    {
      "source": "/api/hub/games/flags/",
      "destination": "/api/flags"
    },
    {
      "source": "/api/hub/admin/flags",
      "destination": "/api/flags"
    },
    {
      "source": "/api/hub/admin/flags/",
      "destination": "/api/flags"
    },
    {
      "source": "/api/hub/submit-game",
      "destination": "/api/submissions"
    },
    {
      "source": "/api/hub/submit-game/",
      "destination": "/api/submissions"
    },
    {
      "source": "/api/hub/:path*",
      "destination": "https://polytrack-hub-api.sawyerbobk563.workers.dev/api/:path*"
    },
    {
      "source": "/api/proxy/ruffle/:path*",
      "destination": "https://unpkg.com/@ruffle-rs/ruffle@0.7.1/:path*"
    },
    {
      "source": "/api/proxy/og/:path*",
      "destination": "https://www.onlinegames.io/:path*"
    },
    {
      "source": "/api/proxy/ogc/:path*",
      "destination": "https://cloud.onlinegames.io/:path*"
    }
  ]
}
